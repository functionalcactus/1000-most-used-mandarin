 {"id":"g3-12","level":3,"group":"Aspect","title":"Verb1 + 着 + Verb2 (doing while…)","pattern":"Verb1 + 着 + Verb2"},
 {"id":"g3-13","level":3,"group":"Adverbs","title":"就 vs 才 (early/easy vs late/hard)","pattern":"Time + 就 + Verb + 了 · Time + 才 + Verb"},
 {"id":"g3-14","level":3,"group":"Adverbs","title":"又 vs 再 (again, past vs future)","pattern":"又 + Verb + 了 · 再 + Verb"},
 {"id":"g3-15","level":3,"group":"Adverbs","title":"越来越 / 越……越……","pattern":"越来越 + Adj · 越 + A + 越 + B"},
 {"id":"g3-16","level":3,"group":"Adverbs","title":"一直 / 总是 / 终于","pattern":"一直/总是/终于 + Verb"},
 {"id":"g3-17","level":3,"group":"Modals","title":"应该 / 该……了 / 得 (děi)","pattern":"应该 + Verb · 该 + Verb + 了"},
 {"id":"g3-18","level":3,"group":"Modals","title":"不用 / 不必 (no need)","pattern":"不用/不必 + Verb"},
 {"id":"g3-19","level":3,"group":"Prepositions","title":"为 / 为了 / 向 / 关于 / 根据","pattern":"为了 + Goal，…… · 向 + Person + Verb"},
 {"id":"g3-20","level":3,"group":"Connectors","title":"先……再/然后……","pattern":"先 + Verb1，再/然后 + Verb2"},
 {"id":"g3-21","level":3,"group":"Connectors","title":"不但……而且……","pattern":"不但 + A，而且 + B"},
 {"id":"g3-22","level":3,"group":"Connectors","title":"如果……就… / ……的话","pattern":"如果 + Condition，就 + Result"},
 {"id":"g3-23","level":3,"group":"Connectors","title":"只要……就… / 只有……才…","pattern":"只要 A 就 B · 只有 A 才 B"},
 {"id":"g3-24","level":3,"group":"Connectors","title":"又……又… / 一边……一边…","pattern":"又 + Adj + 又 + Adj · 一边 V1 一边 V2"},
 {"id":"g3-25","level":3,"group":"Connectors","title":"或者 (or, in statements)","pattern":"A + 或者 + B"},
 {"id":"g3-26","level":3,"group":"Fixed patterns","title":"除了……以外，……还/也/都……","pattern":"除了 + A + 以外，还/也/都 + B"},
 {"id":"g3-27","level":3,"group":"Fixed patterns","title":"对……来说","pattern":"对 + Person + 来说，……"},
 {"id":"g3-28","level":3,"group":"Fixed patterns","title":"一……也/都不… / 一点儿也不","pattern":"一点儿也不 + Adj · 一 + Measure + Noun + 也不/没 + Verb"},
 {"id":"g3-29","level":3,"group":"Fixed patterns","title":"（在）……以前/以后","pattern":"Event + 以前/以后，……"},
 {"id":"g3-30","level":3,"group":"Fixed patterns","title":"看起来 / 看上去 / 好像","pattern":"Subject + 看起来/好像 + Adj"},
 {"id":"g3-31","level":3,"group":"Questions","title":"Rhetorical 不是……吗？","pattern":"不是 + …… + 吗？"},
 {"id":"g3-32","level":3,"group":"Questions","title":"Question words meaning 'any/every' (谁都, 什么都)","pattern":"Question word + 都/也 + Verb"},
 {"id":"g3-33","level":3,"group":"Structures","title":"Something appears/disappears at a place","pattern":"Place + Verb + 了 + Number + Noun"},
 {"id":"g3-34","level":3,"group":"Expressions","title":"Rough numbers (大概, 三四个)","pattern":"大概 + Number · Adjacent numbers"}
