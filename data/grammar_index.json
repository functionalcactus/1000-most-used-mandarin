[
 {"id":"g1-01","level":1,"group":"Sentence frame","title":"是 to link nouns (A is B)","pattern":"A + 是 + B"},
 {"id":"g1-02","level":1,"group":"Sentence frame","title":"有 for having / there is","pattern":"(Place/Person) + 有 + Noun"},
 {"id":"g1-03","level":1,"group":"Sentence frame","title":"Adjective predicate with 很","pattern":"Subject + 很 + Adj"},
 {"id":"g1-04","level":1,"group":"Sentence frame","title":"Noun predicate (dates, ages, prices)","pattern":"Subject + Time/Age/Price"},
 {"id":"g1-05","level":1,"group":"Sentence frame","title":"Time and place come before the verb","pattern":"Subject + Time + 在 + Place + Verb"},
 {"id":"g1-06","level":1,"group":"Questions","title":"Yes/no questions with 吗","pattern":"Statement + 吗？"},
 {"id":"g1-07","level":1,"group":"Questions","title":"Question words stay in place","pattern":"什么/谁/哪儿/几/多少/怎么 in the answer's position"},
 {"id":"g1-08","level":1,"group":"Questions","title":"Affirmative-negative questions","pattern":"Verb/Adj + 不 + Verb/Adj？"},
 {"id":"g1-09","level":1,"group":"Questions","title":"呢 for 'and you?' / 'where is…?'","pattern":"Noun + 呢？"},
 {"id":"g1-10","level":1,"group":"Negation","title":"不 vs 没（有）","pattern":"不 + Verb (habit/future) · 没 + Verb (didn't/haven't)"},
 {"id":"g1-11","level":1,"group":"Negation","title":"不要 for 'don't'","pattern":"不要 + Verb"},
 {"id":"g1-12","level":1,"group":"Modals","title":"会 / 能 / 可以","pattern":"Subject + 会/能/可以 + Verb"},
 {"id":"g1-13","level":1,"group":"Modals","title":"想 and 要 (want to)","pattern":"Subject + 想/要 + Verb"},
 {"id":"g1-14","level":1,"group":"Modifiers","title":"的 to link a modifier to a noun","pattern":"Modifier + 的 + Noun"},
 {"id":"g1-15","level":1,"group":"Modifiers","title":"Measure words","pattern":"Number/这/那 + Measure word + Noun"},
 {"id":"g1-16","level":1,"group":"Modifiers","title":"二 vs 两","pattern":"两 + Measure word · 二 in counting"},
 {"id":"g1-17","level":1,"group":"Adverbs","title":"Degree adverbs 太…了 / 真 / 非常 / 有点儿","pattern":"太 + Adj + 了 · 有点儿 + Adj"},
 {"id":"g1-18","level":1,"group":"Adverbs","title":"也 and 都 before the verb","pattern":"Subject + 也/都 + Verb"},
 {"id":"g1-19","level":1,"group":"Aspect","title":"在 / 正在 for actions in progress","pattern":"Subject + 在/正在 + Verb (+ 呢)"},
 {"id":"g1-20","level":1,"group":"Aspect","title":"了 for a completed action","pattern":"Verb + 了 (+ Object)"},
 {"id":"g1-21","level":1,"group":"Aspect","title":"了 at sentence end for a change","pattern":"…… + 了 (new situation)"},
 {"id":"g1-22","level":1,"group":"Particles","title":"吧 for suggestions","pattern":"Verb phrase + 吧"},
 {"id":"g1-23","level":1,"group":"Prepositions","title":"在 for location of an action","pattern":"在 + Place + Verb"},
 {"id":"g1-24","level":1,"group":"Prepositions","title":"和 (and / with)","pattern":"A + 和 + B"},
 {"id":"g1-25","level":1,"group":"Verbs","title":"Separable verbs (睡觉, 说话…)","pattern":"Verb + (了/个) + Object part"},
 {"id":"g1-26","level":1,"group":"Verbs","title":"Verb series: going somewhere to do something","pattern":"Subject + 去/来 + Place + Verb"},
 {"id":"g1-27","level":1,"group":"Expressions","title":"Dates and times","pattern":"年 → 月 → 日 → 星期 · 点 → 分"},
 {"id":"g1-28","level":1,"group":"Expressions","title":"Ordinal numbers with 第","pattern":"第 + Number (+ Measure word)"},

 {"id":"g2-01","level":2,"group":"Comparison","title":"比 comparisons","pattern":"A + 比 + B + Adj (+ amount)"},
 {"id":"g2-02","level":2,"group":"Comparison","title":"没有 comparisons","pattern":"A + 没有 + B + (那么) + Adj"},
 {"id":"g2-03","level":2,"group":"Complements","title":"得 to describe how an action is done","pattern":"Verb + 得 + Adj"},
 {"id":"g2-04","level":2,"group":"Complements","title":"Result complements 完/懂/好/错/会","pattern":"Verb + 完/懂/好/错/会"},
 {"id":"g2-05","level":2,"group":"Complements","title":"Direction complements 来/去","pattern":"Verb + 来/去 · Verb + 出来/回去/进来…"},
 {"id":"g2-06","level":2,"group":"Complements","title":"Duration of an action","pattern":"Verb + (了) + Duration (+ Object)"},
 {"id":"g2-07","level":2,"group":"Aspect","title":"过 for past experience","pattern":"Verb + 过 (+ Object)"},
 {"id":"g2-08","level":2,"group":"Aspect","title":"着 for an ongoing state","pattern":"Verb + 着"},
 {"id":"g2-09","level":2,"group":"Aspect","title":"快要/就要/要……了 (about to)","pattern":"快要/就要 + Verb + 了"},
 {"id":"g2-10","level":2,"group":"Structures","title":"是……的 to stress when/where/how","pattern":"Subject + 是 + Time/Place/Way + Verb + 的"},
 {"id":"g2-11","level":2,"group":"Structures","title":"请/叫/让 (ask/make someone do)","pattern":"A + 请/叫/让 + B + Verb"},
 {"id":"g2-12","level":2,"group":"Structures","title":"给 with two objects","pattern":"Verb + 给 + Person + Thing"},
 {"id":"g2-13","level":2,"group":"Structures","title":"Place + Verb + 着 (something is there)","pattern":"Place + Verb + 着 + Noun"},
 {"id":"g2-14","level":2,"group":"Questions","title":"还是 for 'or' in questions","pattern":"A + 还是 + B？"},
 {"id":"g2-15","level":2,"group":"Questions","title":"为什么 (why)","pattern":"Subject + 为什么 + Verb？"},
 {"id":"g2-16","level":2,"group":"Negation","title":"别 for 'don't'","pattern":"别 + Verb (+ 了)"},
 {"id":"g2-17","level":2,"group":"Verbs","title":"Verb doubling for 'a little'","pattern":"VV · V一V · V了V"},
 {"id":"g2-18","level":2,"group":"Modifiers","title":"地 to describe how (adverbial)","pattern":"Adj + 地 + Verb"},
 {"id":"g2-19","level":2,"group":"Adverbs","title":"已经……了 (already)","pattern":"已经 + Verb + 了"},
 {"id":"g2-20","level":2,"group":"Adverbs","title":"再 vs 还 (again / still)","pattern":"再 + Verb (future) · 还 + Verb (still)"},
 {"id":"g2-21","level":2,"group":"Adverbs","title":"就 for 'then / right away'","pattern":"…… + 就 + Verb"},
 {"id":"g2-22","level":2,"group":"Prepositions","title":"从 / 往 / 跟 / 给","pattern":"从 + Place · 往 + Direction · 跟 + Person"},
 {"id":"g2-23","level":2,"group":"Connectors","title":"因为……所以……","pattern":"因为 + Reason，所以 + Result"},
 {"id":"g2-24","level":2,"group":"Connectors","title":"虽然……但是……","pattern":"虽然 + A，但是 + B"},
 {"id":"g2-25","level":2,"group":"Connectors","title":"一……就…… (as soon as)","pattern":"一 + Verb1，就 + Verb2"},
 {"id":"g2-26","level":2,"group":"Expressions","title":"Approximate numbers with 几 / 多","pattern":"几 + Measure · Number + 多 + Measure"},

 {"id":"g3-01","level":3,"group":"把 / 被","title":"把 sentences (doing something to an object)","pattern":"Subject + 把 + Object + Verb + Result"},
 {"id":"g3-02","level":3,"group":"把 / 被","title":"把 + Verb + 在/到 + Place","pattern":"Subject + 把 + Object + Verb + 在/到 + Place"},
 {"id":"g3-03","level":3,"group":"把 / 被","title":"被 passive","pattern":"Subject + 被 + (Doer) + Verb + Result"},
 {"id":"g3-04","level":3,"group":"Comparison","title":"A 跟 B 一样 (+ Adj)","pattern":"A + 跟 + B + 一样 (+ Adj)"},
 {"id":"g3-05","level":3,"group":"Comparison","title":"比 + 更/还","pattern":"A + 比 + B + 更/还 + Adj"},
 {"id":"g3-06","level":3,"group":"Comparison","title":"A 不比 B + Adj","pattern":"A + 不比 + B + Adj"},
 {"id":"g3-07","level":3,"group":"Complements","title":"Potential complements 得/不","pattern":"Verb + 得/不 + Result"},
 {"id":"g3-08","level":3,"group":"Complements","title":"Result complements 到/住/走/上","pattern":"Verb + 到/住/走/上"},
 {"id":"g3-09","level":3,"group":"Complements","title":"起来 / 下去 / 下来 (start, continue)","pattern":"Verb + 起来 · Verb + 下去"},
 {"id":"g3-10","level":3,"group":"Complements","title":"极了 / 得很 (extremely)","pattern":"Adj + 极了 · Adj + 得很"},
