[{"id":"g1-01","level":1,"group":"Sentence frame","title":"是 to link nouns (A is B)","pattern":"A + 是 + B","note_en":"Use 是 to say A is B when both sides are nouns. Don't use 是 before adjectives.","note_th":"ใช้ 是 เชื่อมคำนามกับคำนาม (A คือ B) ห้ามใช้ 是 หน้าคำคุณศัพท์","ex":[{"zh":"我是学生。","en":"I'm a student.","th":"ฉันเป็นนักเรียน","focus":"是","dis":["在","有"],"tk":[{"t":"我","py":"wǒ"},{"t":"是","py":"shì"},{"t":"学生","py":"xuéshēng"},{"t":"。"}]},{"zh":"他是我哥哥。","en":"He's my older brother.","th":"เขาเป็นพี่ชายของฉัน","focus":"是","dis":["有","很"],"tk":[{"t":"他","py":"tā"},{"t":"是","py":"shì"},{"t":"我","py":"wǒ"},{"t":"哥哥","py":"gēge"},{"t":"。"}]},{"zh":"这是我的手机。","en":"This is my phone.","th":"นี่คือมือถือของฉัน","focus":"是","dis":["在","的"],"tk":[{"t":"这","py":"zhè"},{"t":"是","py":"shì"},{"t":"我","py":"wǒ"},{"t":"的","py":"de"},{"t":"手机","py":"shǒujī"},{"t":"。"}]},{"zh":"她不是老师。","en":"She isn't a teacher.","th":"เธอไม่ใช่ครู","focus":"是","dis":["有","在"],"tk":[{"t":"她","py":"tā"},{"t":"不","py":"bù"},{"t":"是","py":"shì"},{"t":"老师","py":"lǎoshī"},{"t":"。"}]}]},{"id":"g1-02","level":1,"group":"Sentence frame","title":"有 for having / there is","pattern":"(Place/Person) + 有 + Noun","note_en":"有 means \"to have\" or \"there is\". Its negative is always 没有, never 不有.","note_th":"有 แปลว่า \"มี\" รูปปฏิเสธคือ 没有 เสมอ ไม่ใช้ 不有","ex":[{"zh":"我有一个妹妹。","en":"I have a younger sister.","th":"ฉันมีน้องสาวหนึ่งคน","focus":"有","dis":["是","在"],"tk":[{"t":"我","py":"wǒ"},{"t":"有","py":"yǒu"},{"t":"一","py":"yī"},{"t":"个","py":"gè"},{"t":"妹妹","py":"mèimei"},{"t":"。"}]},{"zh":"桌子上有一本书。","en":"There's a book on the table.","th":"บนโต๊ะมีหนังสือหนึ่งเล่ม","focus":"有","dis":["是","在"],"tk":[{"t":"桌子","py":"zhuōzi"},{"t":"上","py":"shàng"},{"t":"有","py":"yǒu"},{"t":"一","py":"yī"},{"t":"本","py":"běn"},{"t":"书","py":"shū"},{"t":"。"}]},{"zh":"我没有钱。","en":"I don't have money.","th":"ฉันไม่มีเงิน","focus":"没有","dis":["不有","不是"],"tk":[{"t":"我","py":"wǒ"},{"t":"没有","py":"méiyǒu"},{"t":"钱","py":"qián"},{"t":"。"}]},{"zh":"学校里有超市吗？","en":"Is there a supermarket in the school?","th":"ในโรงเรียนมีซูเปอร์มาร์เก็ตไหม","focus":"有","dis":["是","在"],"tk":[{"t":"学校","py":"xuéxiào"},{"t":"里","py":"lǐ"},{"t":"有","py":"yǒu"},{"t":"超市","py":"chāoshì"},{"t":"吗","py":"ma"},{"t":"？"}]}]},{"id":"g1-03","level":1,"group":"Sentence frame","title":"Adjective predicate with 很","pattern":"Subject + 很 + Adj","note_en":"Adjectives act as the verb. Put 很 before them in plain statements; it often doesn't mean \"very\".","note_th":"คำคุณศัพท์ทำหน้าที่เป็นกริยาได้เลย ประโยคบอกเล่าทั่วไปมักใส่ 很 ข้างหน้า (ไม่จำเป็นต้องแปลว่า \"มาก\")","ex":[{"zh":"我很忙。","en":"I'm busy.","th":"ฉันยุ่ง","focus":"很","dis":["是","有"],"tk":[{"t":"我","py":"wǒ"},{"t":"很","py":"hěn"},{"t":"忙","py":"máng"},{"t":"。"}]},{"zh":"今天很冷。","en":"It's cold today.","th":"วันนี้หนาว","focus":"很","dis":["是","在"],"tk":[{"t":"今天","py":"jīntiān"},{"t":"很","py":"hěn"},{"t":"冷","py":"lěng"},{"t":"。"}]},{"zh":"这个苹果很大。","en":"This apple is big.","th":"แอปเปิลลูกนี้ใหญ่","focus":"很","dis":["是","有"],"tk":[{"t":"这个","py":"zhège"},{"t":"苹果","py":"píngguǒ"},{"t":"很","py":"hěn"},{"t":"大","py":"dà"},{"t":"。"}]},{"zh":"他的房间不大。","en":"His room isn't big.","th":"ห้องของเขาไม่ใหญ่","focus":"不","dis":["没","是"],"tk":[{"t":"他","py":"tā"},{"t":"的","py":"de"},{"t":"房间","py":"fángjiān"},{"t":"不","py":"bù"},{"t":"大","py":"dà"},{"t":"。"}]}]},{"id":"g1-04","level":1,"group":"Sentence frame","title":"Noun predicate (dates, ages, prices)","pattern":"Subject + Time/Age/Price","note_en":"Dates, ages and prices can be the whole predicate without 是.","note_th":"วันที่ อายุ และราคา เป็นภาคแสดงได้เลยโดยไม่ต้องใช้ 是","ex":[{"zh":"今天星期一。","en":"Today is Monday.","th":"วันนี้วันจันทร์","focus":"星期一","dis":["是星期","有星期"],"tk":[{"t":"今天","py":"jīntiān"},{"t":"星期","py":"xīngqī"},{"t":"一","py":"yī"},{"t":"。"}]},{"zh":"我弟弟八岁。","en":"My younger brother is eight.","th":"น้องชายฉันอายุแปดขวบ","focus":"八岁","dis":["是八","有八"],"tk":[{"t":"我","py":"wǒ"},{"t":"弟弟","py":"dìdi"},{"t":"八","py":"bā"},{"t":"岁","py":"suì"},{"t":"。"}]},{"zh":"这个苹果五块钱。","en":"This apple is five yuan.","th":"แอปเปิลลูกนี้ห้าหยวน","focus":"五块钱","dis":["是五块","有五块"],"tk":[{"t":"这个","py":"zhège"},{"t":"苹果","py":"píngguǒ"},{"t":"五","py":"wǔ"},{"t":"块","py":"kuài"},{"t":"钱","py":"qián"},{"t":"。"}]},{"zh":"现在三点。","en":"It's three o'clock.","th":"ตอนนี้สามโมง","focus":"三点","dis":["是三","有三"],"tk":[{"t":"现在","py":"xiànzài"},{"t":"三","py":"sān"},{"t":"点","py":"diǎn"},{"t":"。"}]}]},{"id":"g1-05","level":1,"group":"Sentence frame","title":"Time and place come before the verb","pattern":"Subject + Time + 在 + Place + Verb","note_en":"Chinese order is Subject + Time + Place + Verb. Time and place come before the action, not after.","note_th":"ลำดับคำคือ ประธาน + เวลา + สถานที่ + กริยา เวลาและสถานที่อยู่หน้ากริยาเสมอ","ex":[{"zh":"我明天在家休息。","en":"I'm resting at home tomorrow.","th":"พรุ่งนี้ฉันพักผ่อนที่บ้าน","focus":"在家","dis":["家在","在"],"tk":[{"t":"我","py":"wǒ"},{"t":"明天","py":"míngtiān"},{"t":"在","py":"zài"},{"t":"家","py":"jiā"},{"t":"休息","py":"xiūxi"},{"t":"。"}]},{"zh":"他中午在公司吃饭。","en":"He eats at the company at noon.","th":"ตอนเที่ยงเขากินข้าวที่บริษัท","focus":"在公司","dis":["公司在","到"],"tk":[{"t":"他","py":"tā"},{"t":"中午","py":"zhōngwǔ"},{"t":"在","py":"zài"},{"t":"公司","py":"gōngsī"},{"t":"吃","py":"chī"},{"t":"饭","py":"fàn"},{"t":"。"}]},{"zh":"我们晚上在饭店吃饭。","en":"We're eating at a restaurant tonight.","th":"คืนนี้เรากินข้าวที่ร้านอาหาร","focus":"在饭店","dis":["饭店在","去"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"晚上","py":"wǎnshang"},{"t":"在","py":"zài"},{"t":"饭店","py":"fàndiàn"},{"t":"吃","py":"chī"},{"t":"饭","py":"fàn"},{"t":"。"}]},{"zh":"她上午在学校上课。","en":"She has class at school in the morning.","th":"ตอนเช้าเธอเรียนที่โรงเรียน","focus":"在学校","dis":["学校在","到"],"tk":[{"t":"她","py":"tā"},{"t":"上午","py":"shàngwǔ"},{"t":"在","py":"zài"},{"t":"学校","py":"xuéxiào"},{"t":"上课","py":"shàngkè"},{"t":"。"}]}]},{"id":"g1-06","level":1,"group":"Questions","title":"Yes/no questions with 吗","pattern":"Statement + 吗？","note_en":"Add 吗 to the end of a statement to make a yes/no question.","note_th":"เติม 吗 ท้ายประโยคบอกเล่า เพื่อทำเป็นคำถามแบบใช่/ไม่ใช่","ex":[{"zh":"你是老师吗？","en":"Are you a teacher?","th":"คุณเป็นครูไหม","focus":"吗","dis":["呢","吧"],"tk":[{"t":"你","py":"nǐ"},{"t":"是","py":"shì"},{"t":"老师","py":"lǎoshī"},{"t":"吗","py":"ma"},{"t":"？"}]},{"zh":"你喜欢喝茶吗？","en":"Do you like tea?","th":"คุณชอบดื่มชาไหม","focus":"吗","dis":["呢","了"],"tk":[{"t":"你","py":"nǐ"},{"t":"喜欢","py":"xǐhuan"},{"t":"喝","py":"hē"},{"t":"茶","py":"chá"},{"t":"吗","py":"ma"},{"t":"？"}]},{"zh":"他在家吗？","en":"Is he at home?","th":"เขาอยู่บ้านไหม","focus":"吗","dis":["呢","的"],"tk":[{"t":"他","py":"tā"},{"t":"在","py":"zài"},{"t":"家","py":"jiā"},{"t":"吗","py":"ma"},{"t":"？"}]},{"zh":"你吃饭了吗？","en":"Have you eaten?","th":"คุณกินข้าวหรือยัง","focus":"吗","dis":["呢","吧"],"tk":[{"t":"你","py":"nǐ"},{"t":"吃","py":"chī"},{"t":"饭","py":"fàn"},{"t":"了","py":"le"},{"t":"吗","py":"ma"},{"t":"？"}]}]},{"id":"g1-07","level":1,"group":"Questions","title":"Question words stay in place","pattern":"什么/谁/哪儿/几/多少/怎么 in the answer's position","note_en":"Question words go where the answer would go. Don't move them to the front, and don't add 吗.","note_th":"คำแสดงคำถามวางตรงตำแหน่งของคำตอบ ไม่ต้องย้ายไปหน้าประโยค และไม่ต้องเติม 吗","ex":[{"zh":"你叫什么名字？","en":"What's your name?","th":"คุณชื่ออะไร","focus":"什么","dis":["谁","哪儿"],"tk":[{"t":"你","py":"nǐ"},{"t":"叫","py":"jiào"},{"t":"什么","py":"shénme"},{"t":"名字","py":"míngzi"},{"t":"？"}]},{"zh":"他是谁？","en":"Who is he?","th":"เขาคือใคร","focus":"谁","dis":["什么","哪"],"tk":[{"t":"他","py":"tā"},{"t":"是","py":"shì"},{"t":"谁","py":"shéi/shuí"},{"t":"？"}]},{"zh":"你去哪儿？","en":"Where are you going?","th":"คุณจะไปไหน","focus":"哪儿","dis":["什么","谁"],"tk":[{"t":"你","py":"nǐ"},{"t":"去","py":"qù"},{"t":"哪儿","py":"nǎr"},{"t":"？"}]},{"zh":"你家有几口人？","en":"How many people are in your family?","th":"บ้านคุณมีกี่คน","focus":"几","dis":["什么","哪"],"tk":[{"t":"你","py":"nǐ"},{"t":"家","py":"jiā"},{"t":"有","py":"yǒu"},{"t":"几","py":"jǐ"},{"t":"口","py":"kǒu"},{"t":"人","py":"rén"},{"t":"？"}]}]},{"id":"g1-08","level":1,"group":"Questions","title":"Affirmative-negative questions","pattern":"Verb/Adj + 不 + Verb/Adj？","note_en":"Ask a question by saying the verb + 不 + verb. No 吗 is needed.","note_th":"ถามด้วยรูป กริยา + 不 + กริยา โดยไม่ต้องใช้ 吗","ex":[{"zh":"你是不是学生？","en":"Are you a student or not?","th":"คุณเป็นนักเรียนหรือเปล่า","focus":"是不是","dis":["是吗是","不是是"],"tk":[{"t":"你","py":"nǐ"},{"t":"是","py":"shì"},{"t":"不","py":"bù"},{"t":"是","py":"shì"},{"t":"学生","py":"xuéshēng"},{"t":"？"}]},{"zh":"你去不去？","en":"Are you going or not?","th":"คุณจะไปหรือไม่ไป","focus":"去不去","dis":["去没去","不去去"],"tk":[{"t":"你","py":"nǐ"},{"t":"去","py":"qù"},{"t":"不","py":"bù"},{"t":"去","py":"qù"},{"t":"？"}]},{"zh":"这个贵不贵？","en":"Is this expensive?","th":"อันนี้แพงไหม","focus":"贵不贵","dis":["贵没贵","很贵"],"tk":[{"t":"这个","py":"zhège"},{"t":"贵","py":"guì"},{"t":"不","py":"bù"},{"t":"贵","py":"guì"},{"t":"？"}]},{"zh":"你喜欢不喜欢？","en":"Do you like it or not?","th":"คุณชอบหรือไม่ชอบ","focus":"喜欢不喜欢","dis":["喜欢没喜欢","不喜欢"],"tk":[{"t":"你","py":"nǐ"},{"t":"喜欢","py":"xǐhuan"},{"t":"不","py":"bù"},{"t":"喜欢","py":"xǐhuan"},{"t":"？"}]}]},{"id":"g1-09","level":1,"group":"Questions","title":"呢 for 'and you?' / 'where is…?'","pattern":"Noun + 呢？","note_en":"Noun + 呢 asks \"what about…?\" or \"where is…?\".","note_th":"คำนาม + 呢 ใช้ถามว่า \"แล้ว...ล่ะ\" หรือ \"...อยู่ไหน\"","ex":[{"zh":"我很好，你呢？","en":"I'm fine, and you?","th":"ฉันสบายดี แล้วคุณล่ะ","focus":"呢","dis":["吗","吧"],"tk":[{"t":"我","py":"wǒ"},{"t":"很","py":"hěn"},{"t":"好","py":"hǎo"},{"t":"，"},{"t":"你","py":"nǐ"},{"t":"呢","py":"ne"},{"t":"？"}]},{"zh":"我的手机呢？","en":"Where's my phone?","th":"มือถือฉันล่ะ","focus":"呢","dis":["吗","了"],"tk":[{"t":"我","py":"wǒ"},{"t":"的","py":"de"},{"t":"手机","py":"shǒujī"},{"t":"呢","py":"ne"},{"t":"？"}]},{"zh":"我是老师，他呢？","en":"I'm a teacher. What about him?","th":"ฉันเป็นครู แล้วเขาล่ะ","focus":"呢","dis":["吗","的"],"tk":[{"t":"我","py":"wǒ"},{"t":"是","py":"shì"},{"t":"老师","py":"lǎoshī"},{"t":"，"},{"t":"他","py":"tā"},{"t":"呢","py":"ne"},{"t":"？"}]},{"zh":"妈妈呢？","en":"Where's Mom?","th":"แม่ล่ะ","focus":"呢","dis":["吗","吧"],"tk":[{"t":"妈妈","py":"māma"},{"t":"呢","py":"ne"},{"t":"？"}]}]},{"id":"g1-10","level":1,"group":"Negation","title":"不 vs 没（有）","pattern":"不 + Verb (habit/future) · 没 + Verb (didn't/haven't)","note_en":"不 negates habits, wishes and the future. 没 negates the past: \"didn't\" or \"haven't\".","note_th":"不 ปฏิเสธนิสัย ความต้องการ และอนาคต ส่วน 没 ปฏิเสธสิ่งที่ไม่ได้เกิดขึ้นในอดีต","ex":[{"zh":"我不喝茶。","en":"I don't drink tea.","th":"ฉันไม่ดื่มชา","focus":"不","dis":["没","别"],"tk":[{"t":"我","py":"wǒ"},{"t":"不","py":"bù"},{"t":"喝","py":"hē"},{"t":"茶","py":"chá"},{"t":"。"}]},{"zh":"我昨天没去学校。","en":"I didn't go to school yesterday.","th":"เมื่อวานฉันไม่ได้ไปโรงเรียน","focus":"没","dis":["不","别"],"tk":[{"t":"我","py":"wǒ"},{"t":"昨天","py":"zuótiān"},{"t":"没","py":"méi"},{"t":"去","py":"qù"},{"t":"学校","py":"xuéxiào"},{"t":"。"}]},{"zh":"明天我不上班。","en":"I'm not working tomorrow.","th":"พรุ่งนี้ฉันไม่ทำงาน","focus":"不","dis":["没","别"],"tk":[{"t":"明天","py":"míngtiān"},{"t":"我","py":"wǒ"},{"t":"不","py":"bù"},{"t":"上班","py":"shàngbān"},{"t":"。"}]},{"zh":"他还没吃饭。","en":"He hasn't eaten yet.","th":"เขายังไม่ได้กินข้าว","focus":"没","dis":["不","别"],"tk":[{"t":"他","py":"tā"},{"t":"还","py":"hái"},{"t":"没","py":"méi"},{"t":"吃","py":"chī"},{"t":"饭","py":"fàn"},{"t":"。"}]}]},{"id":"g1-11","level":1,"group":"Negation","title":"不要 for 'don't'","pattern":"不要 + Verb","note_en":"不要 + verb means \"don't (do it)\".","note_th":"不要 + กริยา แปลว่า \"อย่า...\"","ex":[{"zh":"不要说话。","en":"Don't talk.","th":"อย่าพูด","focus":"不要","dis":["没要","不是"],"tk":[{"t":"不要","py":"búyào"},{"t":"说话","py":"shuōhuà"},{"t":"。"}]},{"zh":"上课的时候不要睡觉。","en":"Don't sleep in class.","th":"ตอนเรียนอย่านอน","focus":"不要","dis":["没有","不是"],"tk":[{"t":"上课","py":"shàngkè"},{"t":"的","py":"de"},{"t":"时候","py":"shíhou"},{"t":"不要","py":"búyào"},{"t":"睡觉","py":"shuìjiào"},{"t":"。"}]},{"zh":"天气冷，不要生病。","en":"It's cold, don't get sick.","th":"อากาศหนาว อย่าป่วยนะ","focus":"不要","dis":["没有","不是"],"tk":[{"t":"天气","py":"tiānqì"},{"t":"冷","py":"lěng"},{"t":"，"},{"t":"不要","py":"búyào"},{"t":"生病","py":"shēngbìng"},{"t":"。"}]},{"zh":"不要买这个，太贵了。","en":"Don't buy this, it's too expensive.","th":"อย่าซื้ออันนี้ แพงเกินไป","focus":"不要","dis":["没有","不是"],"tk":[{"t":"不要","py":"búyào"},{"t":"买","py":"mǎi"},{"t":"这个","py":"zhège"},{"t":"，"},{"t":"太","py":"tài"},{"t":"贵","py":"guì"},{"t":"了","py":"le"},{"t":"。"}]}]},{"id":"g1-12","level":1,"group":"Modals","title":"会 / 能 / 可以","pattern":"Subject + 会/能/可以 + Verb","note_en":"会 = learned skill. 能 = able, possible. 可以 = allowed, okay.","note_th":"会 = ทำเป็น (ทักษะที่ฝึกมา) 能 = สามารถ เป็นไปได้ 可以 = ได้รับอนุญาต","ex":[{"zh":"我会说汉语。","en":"I can speak Chinese.","th":"ฉันพูดภาษาจีนเป็น","focus":"会","dis":["可以","能"],"tk":[{"t":"我","py":"wǒ"},{"t":"会","py":"huì"},{"t":"说","py":"shuō"},{"t":"汉语","py":"Hànyǔ"},{"t":"。"}]},{"zh":"我今天不能去。","en":"I can't go today.","th":"วันนี้ฉันไปไม่ได้","focus":"能","dis":["会","可以"],"tk":[{"t":"我","py":"wǒ"},{"t":"今天","py":"jīntiān"},{"t":"不","py":"bù"},{"t":"能","py":"néng"},{"t":"去","py":"qù"},{"t":"。"}]},{"zh":"我可以坐这儿吗？","en":"May I sit here?","th":"ฉันนั่งตรงนี้ได้ไหม","focus":"可以","dis":["会","能"],"tk":[{"t":"我","py":"wǒ"},{"t":"可以","py":"kěyǐ"},{"t":"坐","py":"zuò"},{"t":"这儿","py":"zhèr"},{"t":"吗","py":"ma"},{"t":"？"}]},{"zh":"你会开车吗？","en":"Can you drive?","th":"คุณขับรถเป็นไหม","focus":"会","dis":["可以","能"],"tk":[{"t":"你","py":"nǐ"},{"t":"会","py":"huì"},{"t":"开车","py":"kāichē"},{"t":"吗","py":"ma"},{"t":"？"}]}]},{"id":"g1-13","level":1,"group":"Modals","title":"想 and 要 (want to)","pattern":"Subject + 想/要 + Verb","note_en":"想 = would like to (softer). 要 = want to or going to (firmer).","note_th":"想 = อยาก (นุ่มนวลกว่า) 要 = ต้องการ จะ (หนักแน่นกว่า)","ex":[{"zh":"我想喝茶。","en":"I'd like some tea.","th":"ฉันอยากดื่มชา","focus":"想","dis":["会","能"],"tk":[{"t":"我","py":"wǒ"},{"t":"想","py":"xiǎng"},{"t":"喝","py":"hē"},{"t":"茶","py":"chá"},{"t":"。"}]},{"zh":"我要一杯水。","en":"I want a glass of water.","th":"ฉันเอาน้ำหนึ่งแก้ว","focus":"要","dis":["会","能"],"tk":[{"t":"我","py":"wǒ"},{"t":"要","py":"yào"},{"t":"一","py":"yī"},{"t":"杯","py":"bēi"},{"t":"水","py":"shuǐ"},{"t":"。"}]},{"zh":"明天我要上班。","en":"I have to work tomorrow.","th":"พรุ่งนี้ฉันต้องไปทำงาน","focus":"要","dis":["会","可以"],"tk":[{"t":"明天","py":"míngtiān"},{"t":"我","py":"wǒ"},{"t":"要","py":"yào"},{"t":"上班","py":"shàngbān"},{"t":"。"}]},{"zh":"你想去哪儿？","en":"Where would you like to go?","th":"คุณอยากไปไหน","focus":"想","dis":["会","能"],"tk":[{"t":"你","py":"nǐ"},{"t":"想","py":"xiǎng"},{"t":"去","py":"qù"},{"t":"哪儿","py":"nǎr"},{"t":"？"}]}]},{"id":"g1-14","level":1,"group":"Modifiers","title":"的 to link a modifier to a noun","pattern":"Modifier + 的 + Noun","note_en":"的 links a describer to a noun: the describer comes first.","note_th":"的 เชื่อมคำขยายกับคำนาม โดยคำขยายอยู่หน้าเสมอ (กลับกับภาษาไทย)","ex":[{"zh":"这是我的书。","en":"This is my book.","th":"นี่คือหนังสือของฉัน","focus":"的","dis":["是","了"],"tk":[{"t":"这","py":"zhè"},{"t":"是","py":"shì"},{"t":"我","py":"wǒ"},{"t":"的","py":"de"},{"t":"书","py":"shū"},{"t":"。"}]},{"zh":"妈妈做的菜很好吃。","en":"The food Mom makes is delicious.","th":"อาหารที่แม่ทำอร่อยมาก","focus":"的","dis":["了","是"],"tk":[{"t":"妈妈","py":"māma"},{"t":"做","py":"zuò"},{"t":"的","py":"de"},{"t":"菜","py":"cài"},{"t":"很","py":"hěn"},{"t":"好吃","py":"hǎochī"},{"t":"。"}]},{"zh":"他是我的好朋友。","en":"He's my good friend.","th":"เขาเป็นเพื่อนสนิทของฉัน","focus":"的","dis":["了","是"],"tk":[{"t":"他","py":"tā"},{"t":"是","py":"shì"},{"t":"我","py":"wǒ"},{"t":"的","py":"de"},{"t":"好","py":"hǎo"},{"t":"朋友","py":"péngyou"},{"t":"。"}]},{"zh":"这是谁的手机？","en":"Whose phone is this?","th":"นี่มือถือของใคร","focus":"的","dis":["了","吗"],"tk":[{"t":"这","py":"zhè"},{"t":"是","py":"shì"},{"t":"谁","py":"shéi/shuí"},{"t":"的","py":"de"},{"t":"手机","py":"shǒujī"},{"t":"？"}]}]},{"id":"g1-15","level":1,"group":"Modifiers","title":"Measure words","pattern":"Number/这/那 + Measure word + Noun","note_en":"A number or 这/那 needs a measure word before the noun. 个 is the general one.","note_th":"ตัวเลขหรือ 这/那 ต้องมีลักษณนามก่อนคำนาม 个 ใช้ได้ทั่วไป","ex":[{"zh":"我有三个朋友。","en":"I have three friends.","th":"ฉันมีเพื่อนสามคน","focus":"个","dis":["本","只"],"tk":[{"t":"我","py":"wǒ"},{"t":"有","py":"yǒu"},{"t":"三","py":"sān"},{"t":"个","py":"gè"},{"t":"朋友","py":"péngyou"},{"t":"。"}]},{"zh":"我买了两本书。","en":"I bought two books.","th":"ฉันซื้อหนังสือสองเล่ม","focus":"本","dis":["个","只"],"tk":[{"t":"我","py":"wǒ"},{"t":"买","py":"mǎi"},{"t":"了","py":"le"},{"t":"两","py":"liǎng"},{"t":"本","py":"běn"},{"t":"书","py":"shū"},{"t":"。"}]},{"zh":"我家有一只猫。","en":"My family has a cat.","th":"บ้านฉันมีแมวหนึ่งตัว","focus":"只","dis":["本","件"],"tk":[{"t":"我","py":"wǒ"},{"t":"家","py":"jiā"},{"t":"有","py":"yǒu"},{"t":"一","py":"yī"},{"t":"只","py":"zhī"},{"t":"猫","py":"māo"},{"t":"。"}]},{"zh":"这件衣服很漂亮。","en":"This piece of clothing is pretty.","th":"เสื้อตัวนี้สวยมาก","focus":"件","dis":["本","只"],"tk":[{"t":"这","py":"zhè"},{"t":"件","py":"jiàn"},{"t":"衣服","py":"yīfu"},{"t":"很","py":"hěn"},{"t":"漂亮","py":"piàoliang"},{"t":"。"}]}]},{"id":"g1-16","level":1,"group":"Modifiers","title":"二 vs 两","pattern":"两 + Measure word · 二 in counting","note_en":"Use 两 before a measure word, e.g. 两个. Use 二 when counting, in numbers like 十二, and in dates.","note_th":"ใช้ 两 หน้าลักษณนาม (两个) ใช้ 二 ในการนับเลข ตัวเลขอย่าง 十二 และวันที่","ex":[{"zh":"我有两个哥哥。","en":"I have two older brothers.","th":"ฉันมีพี่ชายสองคน","focus":"两","dis":["二","第"],"tk":[{"t":"我","py":"wǒ"},{"t":"有","py":"yǒu"},{"t":"两","py":"liǎng"},{"t":"个","py":"gè"},{"t":"哥哥","py":"gēge"},{"t":"。"}]},{"zh":"今天是二月二日。","en":"Today is February 2nd.","th":"วันนี้วันที่สองกุมภาพันธ์","focus":"二","dis":["两","第"],"tk":[{"t":"今天","py":"jīntiān"},{"t":"是","py":"shì"},{"t":"二","py":"èr"},{"t":"月","py":"yuè"},{"t":"二","py":"èr"},{"t":"日","py":"rì"},{"t":"。"}]},{"zh":"我要两杯茶。","en":"I'd like two cups of tea.","th":"ขอชาสองแก้ว","focus":"两","dis":["二","第"],"tk":[{"t":"我","py":"wǒ"},{"t":"要","py":"yào"},{"t":"两","py":"liǎng"},{"t":"杯","py":"bēi"},{"t":"茶","py":"chá"},{"t":"。"}]},{"zh":"我十二岁。","en":"I'm twelve.","th":"ฉันอายุสิบสองปี","focus":"二","dis":["两","第"],"tk":[{"t":"我","py":"wǒ"},{"t":"十二","py":"shíèr"},{"t":"岁","py":"suì"},{"t":"。"}]}]},{"id":"g1-17","level":1,"group":"Adverbs","title":"Degree adverbs 太…了 / 真 / 非常 / 有点儿","pattern":"太 + Adj + 了 · 有点儿 + Adj","note_en":"太…了 = too or so (strong). 真 = really. 非常 = extremely. 有点儿 = a bit, usually negative.","note_th":"太…了 = เกินไป/มากๆ 真 = จริงๆ 非常 = อย่างยิ่ง 有点儿 = นิดหน่อย (มักแง่ลบ)","ex":[{"zh":"这个太贵了！","en":"This is too expensive!","th":"อันนี้แพงเกินไป","focus":"太","dis":["很","有"],"tk":[{"t":"这个","py":"zhège"},{"t":"太","py":"tài"},{"t":"贵","py":"guì"},{"t":"了","py":"le"},{"t":"！"}]},{"zh":"今天有点儿冷。","en":"It's a bit cold today.","th":"วันนี้หนาวนิดหน่อย","focus":"有点儿","dis":["一点儿","太"],"tk":[{"t":"今天","py":"jīntiān"},{"t":"有点儿","py":"yǒudiǎnr"},{"t":"冷","py":"lěng"},{"t":"。"}]},{"zh":"你的汉语真好！","en":"Your Chinese is really good!","th":"ภาษาจีนของคุณดีจริงๆ","focus":"真","dis":["太","有点儿"],"tk":[{"t":"你","py":"nǐ"},{"t":"的","py":"de"},{"t":"汉语","py":"Hànyǔ"},{"t":"真","py":"zhēn"},{"t":"好","py":"hǎo"},{"t":"！"}]},{"zh":"我非常喜欢这个电影。","en":"I really love this movie.","th":"ฉันชอบหนังเรื่องนี้มาก","focus":"非常","dis":["太","有点儿"],"tk":[{"t":"我","py":"wǒ"},{"t":"非常","py":"fēicháng"},{"t":"喜欢","py":"xǐhuan"},{"t":"这个","py":"zhège"},{"t":"电影","py":"diànyǐng"},{"t":"。"}]}]},{"id":"g1-18","level":1,"group":"Adverbs","title":"也 and 都 before the verb","pattern":"Subject + 也/都 + Verb","note_en":"也 (also) and 都 (all) go after the subject and before the verb. When used together: 也都.","note_th":"也 (ก็) และ 都 (ทั้งหมด) วางหลังประธาน หน้ากริยา ถ้าใช้คู่กันเรียงเป็น 也都","ex":[{"zh":"我也是学生。","en":"I'm also a student.","th":"ฉันก็เป็นนักเรียน","focus":"也","dis":["都","还"],"tk":[{"t":"我","py":"wǒ"},{"t":"也","py":"yě"},{"t":"是","py":"shì"},{"t":"学生","py":"xuéshēng"},{"t":"。"}]},{"zh":"我们都喜欢喝茶。","en":"We all like tea.","th":"พวกเราชอบดื่มชากันทุกคน","focus":"都","dis":["也","还"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"都","py":"dōu"},{"t":"喜欢","py":"xǐhuan"},{"t":"喝","py":"hē"},{"t":"茶","py":"chá"},{"t":"。"}]},{"zh":"他们也都来了。","en":"They all came too.","th":"พวกเขาก็มากันหมด","focus":"也都","dis":["都也","还都"],"tk":[{"t":"他们","py":"tāmen"},{"t":"也","py":"yě"},{"t":"都","py":"dōu"},{"t":"来","py":"lái"},{"t":"了","py":"le"},{"t":"。"}]},{"zh":"他也喜欢猫。","en":"He likes cats too.","th":"เขาก็ชอบแมว","focus":"也","dis":["都","还"],"tk":[{"t":"他","py":"tā"},{"t":"也","py":"yě"},{"t":"喜欢","py":"xǐhuan"},{"t":"猫","py":"māo"},{"t":"。"}]}]},{"id":"g1-19","level":1,"group":"Aspect","title":"在 / 正在 for actions in progress","pattern":"Subject + 在/正在 + Verb (+ 呢)","note_en":"在 or 正在 before a verb means the action is happening now. 呢 can end the sentence.","note_th":"在/正在 หน้ากริยา = กำลังทำอยู่ ท้ายประโยคใส่ 呢 ได้","ex":[{"zh":"我在吃饭。","en":"I'm eating.","th":"ฉันกำลังกินข้าว","focus":"在","dis":["了","是"],"tk":[{"t":"我","py":"wǒ"},{"t":"在","py":"zài"},{"t":"吃","py":"chī"},{"t":"饭","py":"fàn"},{"t":"。"}]},{"zh":"他正在睡觉呢。","en":"He's sleeping right now.","th":"เขากำลังนอนอยู่","focus":"正在","dis":["了","是"],"tk":[{"t":"他","py":"tā"},{"t":"正在","py":"zhèngzài"},{"t":"睡觉","py":"shuìjiào"},{"t":"呢","py":"ne"},{"t":"。"}]},{"zh":"妈妈在做饭。","en":"Mom is cooking.","th":"แม่กำลังทำอาหาร","focus":"在","dis":["了","是"],"tk":[{"t":"妈妈","py":"māma"},{"t":"在","py":"zài"},{"t":"做饭","py":"zuò fàn"},{"t":"。"}]},{"zh":"你在做什么？","en":"What are you doing?","th":"คุณกำลังทำอะไร","focus":"在","dis":["了","是"],"tk":[{"t":"你","py":"nǐ"},{"t":"在","py":"zài"},{"t":"做","py":"zuò"},{"t":"什么","py":"shénme"},{"t":"？"}]}]},{"id":"g1-20","level":1,"group":"Aspect","title":"了 for a completed action","pattern":"Verb + 了 (+ Object)","note_en":"了 right after a verb means the action was completed.","note_th":"了 หลังกริยา บอกว่าการกระทำเสร็จสิ้นแล้ว","ex":[{"zh":"我买了两本书。","en":"I bought two books.","th":"ฉันซื้อหนังสือมาสองเล่ม","focus":"了","dis":["过","的"],"tk":[{"t":"我","py":"wǒ"},{"t":"买","py":"mǎi"},{"t":"了","py":"le"},{"t":"两","py":"liǎng"},{"t":"本","py":"běn"},{"t":"书","py":"shū"},{"t":"。"}]},{"zh":"他吃了一个苹果。","en":"He ate an apple.","th":"เขากินแอปเปิลไปหนึ่งลูก","focus":"了","dis":["呢","的"],"tk":[{"t":"他","py":"tā"},{"t":"吃","py":"chī"},{"t":"了","py":"le"},{"t":"一","py":"yī"},{"t":"个","py":"gè"},{"t":"苹果","py":"píngguǒ"},{"t":"。"}]},{"zh":"我喝了一杯茶。","en":"I drank a cup of tea.","th":"ฉันดื่มชาไปหนึ่งแก้ว","focus":"了","dis":["呢","的"],"tk":[{"t":"我","py":"wǒ"},{"t":"喝","py":"hē"},{"t":"了","py":"le"},{"t":"一","py":"yī"},{"t":"杯","py":"bēi"},{"t":"茶","py":"chá"},{"t":"。"}]},{"zh":"昨天我看了一个电影。","en":"Yesterday I watched a movie.","th":"เมื่อวานฉันดูหนังมาหนึ่งเรื่อง","focus":"了","dis":["呢","的"],"tk":[{"t":"昨天","py":"zuótiān"},{"t":"我","py":"wǒ"},{"t":"看","py":"kàn"},{"t":"了","py":"le"},{"t":"一","py":"yī"},{"t":"个","py":"gè"},{"t":"电影","py":"diànyǐng"},{"t":"。"}]}]},{"id":"g1-21","level":1,"group":"Aspect","title":"了 at sentence end for a change","pattern":"…… + 了 (new situation)","note_en":"了 at the end of a sentence marks a new situation: \"now…\" or \"already…\".","note_th":"了 ท้ายประโยค บอกว่าสถานการณ์เปลี่ยนไปแล้ว (\"...แล้ว\")","ex":[{"zh":"下雨了。","en":"It's started raining.","th":"ฝนตกแล้ว","focus":"了","dis":["吗","呢"],"tk":[{"t":"下雨","py":"xià yǔ"},{"t":"了","py":"le"},{"t":"。"}]},{"zh":"我二十岁了。","en":"I'm twenty now.","th":"ฉันอายุยี่สิบแล้ว","focus":"了","dis":["吗","呢"],"tk":[{"t":"我","py":"wǒ"},{"t":"二十","py":"èrshí"},{"t":"岁","py":"suì"},{"t":"了","py":"le"},{"t":"。"}]},{"zh":"太晚了，我们回家吧。","en":"It's late now, let's go home.","th":"ดึกแล้ว กลับบ้านกันเถอะ","focus":"了","dis":["吗","呢"],"tk":[{"t":"太","py":"tài"},{"t":"晚","py":"wǎn"},{"t":"了","py":"le"},{"t":"，"},{"t":"我们","py":"wǒmen"},{"t":"回","py":"huí"},{"t":"家","py":"jiā"},{"t":"吧","py":"ba"},{"t":"。"}]},{"zh":"我不忙了。","en":"I'm not busy anymore.","th":"ฉันไม่ยุ่งแล้ว","focus":"了","dis":["吗","呢"],"tk":[{"t":"我","py":"wǒ"},{"t":"不","py":"bù"},{"t":"忙","py":"máng"},{"t":"了","py":"le"},{"t":"。"}]}]},{"id":"g1-22","level":1,"group":"Particles","title":"吧 for suggestions","pattern":"Verb phrase + 吧","note_en":"吧 at the end makes a suggestion (\"let's…\") or checks something you assume.","note_th":"吧 ท้ายประโยคใช้ชวน (\"...กันเถอะ\") หรือถามเพื่อยืนยันสิ่งที่คาดไว้","ex":[{"zh":"我们去吃饭吧。","en":"Let's go eat.","th":"เราไปกินข้าวกันเถอะ","focus":"吧","dis":["吗","呢"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"去","py":"qù"},{"t":"吃","py":"chī"},{"t":"饭","py":"fàn"},{"t":"吧","py":"ba"},{"t":"。"}]},{"zh":"你是老师吧？","en":"You're a teacher, right?","th":"คุณเป็นครูใช่ไหม","focus":"吧","dis":["呢","了"],"tk":[{"t":"你","py":"nǐ"},{"t":"是","py":"shì"},{"t":"老师","py":"lǎoshī"},{"t":"吧","py":"ba"},{"t":"？"}]},{"zh":"我们坐出租车去吧。","en":"Let's take a taxi.","th":"เรานั่งแท็กซี่ไปกันเถอะ","focus":"吧","dis":["吗","呢"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"坐","py":"zuò"},{"t":"出租车","py":"chūzūchē"},{"t":"去","py":"qù"},{"t":"吧","py":"ba"},{"t":"。"}]},{"zh":"你休息一下吧。","en":"Take a rest.","th":"พักสักหน่อยเถอะ","focus":"吧","dis":["吗","呢"],"tk":[{"t":"你","py":"nǐ"},{"t":"休息","py":"xiūxi"},{"t":"一下","py":"yíxià"},{"t":"吧","py":"ba"},{"t":"。"}]}]},{"id":"g1-23","level":1,"group":"Prepositions","title":"在 for location of an action","pattern":"在 + Place + Verb","note_en":"在 + place goes before the verb to say where something happens.","note_th":"在 + สถานที่ วางหน้ากริยา เพื่อบอกว่าเกิดขึ้นที่ไหน","ex":[{"zh":"我在学校学习汉语。","en":"I study Chinese at school.","th":"ฉันเรียนภาษาจีนที่โรงเรียน","focus":"在","dis":["到","有"],"tk":[{"t":"我","py":"wǒ"},{"t":"在","py":"zài"},{"t":"学校","py":"xuéxiào"},{"t":"学习","py":"xuéxí"},{"t":"汉语","py":"Hànyǔ"},{"t":"。"}]},{"zh":"他在医院工作。","en":"He works at a hospital.","th":"เขาทำงานที่โรงพยาบาล","focus":"在","dis":["到","有"],"tk":[{"t":"他","py":"tā"},{"t":"在","py":"zài"},{"t":"医院","py":"yīyuàn"},{"t":"工作","py":"gōngzuò"},{"t":"。"}]},{"zh":"我们在家吃晚饭。","en":"We have dinner at home.","th":"เรากินข้าวเย็นที่บ้าน","focus":"在","dis":["到","有"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"在","py":"zài"},{"t":"家","py":"jiā"},{"t":"吃","py":"chī"},{"t":"晚饭","py":"wǎnfàn"},{"t":"。"}]},{"zh":"你在哪儿工作？","en":"Where do you work?","th":"คุณทำงานที่ไหน","focus":"在","dis":["到","有"],"tk":[{"t":"你","py":"nǐ"},{"t":"在","py":"zài"},{"t":"哪儿","py":"nǎr"},{"t":"工作","py":"gōngzuò"},{"t":"？"}]}]},{"id":"g1-24","level":1,"group":"Prepositions","title":"和 (and / with)","pattern":"A + 和 + B","note_en":"和 links nouns (\"and\" or \"with\"). It doesn't link verbs or sentences.","note_th":"和 เชื่อมคำนาม (\"และ\", \"กับ\") ไม่ใช้เชื่อมกริยาหรือประโยค","ex":[{"zh":"我和妈妈去超市。","en":"Mom and I are going to the supermarket.","th":"ฉันกับแม่ไปซูเปอร์มาร์เก็ต","focus":"和","dis":["也","都"],"tk":[{"t":"我","py":"wǒ"},{"t":"和","py":"hé"},{"t":"妈妈","py":"māma"},{"t":"去","py":"qù"},{"t":"超市","py":"chāoshì"},{"t":"。"}]},{"zh":"我喜欢猫和狗。","en":"I like cats and dogs.","th":"ฉันชอบแมวและหมา","focus":"和","dis":["也","都"],"tk":[{"t":"我","py":"wǒ"},{"t":"喜欢","py":"xǐhuan"},{"t":"猫","py":"māo"},{"t":"和","py":"hé"},{"t":"狗","py":"gǒu"},{"t":"。"}]},{"zh":"爸爸和妈妈都是医生。","en":"Dad and Mom are both doctors.","th":"พ่อและแม่เป็นหมอทั้งคู่","focus":"和","dis":["也","还"],"tk":[{"t":"爸爸","py":"bàba"},{"t":"和","py":"hé"},{"t":"妈妈","py":"māma"},{"t":"都","py":"dōu"},{"t":"是","py":"shì"},{"t":"医生","py":"yīshēng"},{"t":"。"}]},{"zh":"我有一个哥哥和一个妹妹。","en":"I have an older brother and a younger sister.","th":"ฉันมีพี่ชายหนึ่งคนและน้องสาวหนึ่งคน","focus":"和","dis":["也","都"],"tk":[{"t":"我","py":"wǒ"},{"t":"有","py":"yǒu"},{"t":"一","py":"yī"},{"t":"个","py":"gè"},{"t":"哥哥","py":"gēge"},{"t":"和","py":"hé"},{"t":"一","py":"yī"},{"t":"个","py":"gè"},{"t":"妹妹","py":"mèimei"},{"t":"。"}]}]},{"id":"g1-25","level":1,"group":"Verbs","title":"Separable verbs (睡觉, 说话…)","pattern":"Verb + (了/个) + Object part","note_en":"Separable verbs like 睡觉 and 上课 are verb + object. Other words can go in between, e.g. 睡了觉.","note_th":"กริยาแยกได้ เช่น 睡觉 上课 คือกริยา+กรรม สามารถแทรกคำตรงกลางได้ (睡了觉)","ex":[{"zh":"你几点睡觉？","en":"What time do you go to bed?","th":"คุณเข้านอนกี่โมง","focus":"睡觉","dis":["觉睡","睡"],"tk":[{"t":"你","py":"nǐ"},{"t":"几","py":"jǐ"},{"t":"点","py":"diǎn"},{"t":"睡觉","py":"shuìjiào"},{"t":"？"}]},{"zh":"我们九点上课。","en":"We start class at nine.","th":"เราเข้าเรียนตอนเก้าโมง","focus":"上课","dis":["课上","上"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"九","py":"jiǔ"},{"t":"点","py":"diǎn"},{"t":"上课","py":"shàngkè"},{"t":"。"}]},{"zh":"他下班了。","en":"He's gotten off work.","th":"เขาเลิกงานแล้ว","focus":"下班","dis":["班下","下"],"tk":[{"t":"他","py":"tā"},{"t":"下班","py":"xiàbān"},{"t":"了","py":"le"},{"t":"。"}]},{"zh":"我病了，要去看病。","en":"I'm sick and need to see a doctor.","th":"ฉันป่วย ต้องไปหาหมอ","focus":"看病","dis":["病看","看"],"tk":[{"t":"我","py":"wǒ"},{"t":"病","py":"bìng"},{"t":"了","py":"le"},{"t":"，"},{"t":"要","py":"yào"},{"t":"去","py":"qù"},{"t":"看病","py":"kànbìng"},{"t":"。"}]}]},{"id":"g1-26","level":1,"group":"Verbs","title":"Verb series: going somewhere to do something","pattern":"Subject + 去/来 + Place + Verb","note_en":"去/来 + place + verb means going or coming somewhere to do something.","note_th":"去/来 + สถานที่ + กริยา = ไป/มาที่ใดที่หนึ่งเพื่อทำบางอย่าง","ex":[{"zh":"我去超市买水果。","en":"I'm going to the supermarket to buy fruit.","th":"ฉันไปซูเปอร์มาร์เก็ตซื้อผลไม้","focus":"去","dis":["在","到"],"tk":[{"t":"我","py":"wǒ"},{"t":"去","py":"qù"},{"t":"超市","py":"chāoshì"},{"t":"买","py":"mǎi"},{"t":"水果","py":"shuǐguǒ"},{"t":"。"}]},{"zh":"他来中国学习汉语。","en":"He came to China to study Chinese.","th":"เขามาเรียนภาษาจีนที่จีน","focus":"来","dis":["在","到"],"tk":[{"t":"他","py":"tā"},{"t":"来","py":"lái"},{"t":"中国","py":"Zhōngguó"},{"t":"学习","py":"xuéxí"},{"t":"汉语","py":"Hànyǔ"},{"t":"。"}]},{"zh":"我们去饭店吃饭吧。","en":"Let's go to a restaurant to eat.","th":"เราไปกินข้าวที่ร้านอาหารกันเถอะ","focus":"去","dis":["在","有"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"去","py":"qù"},{"t":"饭店","py":"fàndiàn"},{"t":"吃","py":"chī"},{"t":"饭","py":"fàn"},{"t":"吧","py":"ba"},{"t":"。"}]},{"zh":"我去书店买书。","en":"I'm going to the bookstore to buy books.","th":"ฉันไปซื้อหนังสือที่ร้านหนังสือ","focus":"去","dis":["在","有"],"tk":[{"t":"我","py":"wǒ"},{"t":"去","py":"qù"},{"t":"书店","py":"shūdiàn"},{"t":"买","py":"mǎi"},{"t":"书","py":"shū"},{"t":"。"}]}]},{"id":"g1-27","level":1,"group":"Expressions","title":"Dates and times","pattern":"年 → 月 → 日 → 星期 · 点 → 分","note_en":"Dates go big to small: year, month, day, weekday. Times go hour (点), then minute (分).","note_th":"วันที่เรียงจากใหญ่ไปเล็ก: ปี เดือน วัน วันในสัปดาห์ เวลา: ชั่วโมง (点) แล้วนาที (分)","ex":[{"zh":"今天是五月八号。","en":"Today is May 8th.","th":"วันนี้วันที่แปดพฤษภาคม","focus":"五月八号","dis":["八号五月","八五月号"],"tk":[{"t":"今天","py":"jīntiān"},{"t":"是","py":"shì"},{"t":"五","py":"wǔ"},{"t":"月","py":"yuè"},{"t":"八","py":"bā"},{"t":"号","py":"hào"},{"t":"。"}]},{"zh":"现在八点十分。","en":"It's 8:10 now.","th":"ตอนนี้แปดโมงสิบนาที","focus":"八点十分","dis":["十分八点","八分十点"],"tk":[{"t":"现在","py":"xiànzài"},{"t":"八","py":"bā"},{"t":"点","py":"diǎn"},{"t":"十","py":"shí"},{"t":"分","py":"fēn"},{"t":"。"}]},{"zh":"今天星期几？","en":"What day of the week is it?","th":"วันนี้วันอะไร","focus":"星期几","dis":["几星期","星期什么"],"tk":[{"t":"今天","py":"jīntiān"},{"t":"星期","py":"xīngqī"},{"t":"几","py":"jǐ"},{"t":"？"}]},{"zh":"我七点半起床。","en":"I get up at 7:30.","th":"ฉันตื่นนอนตอนเจ็ดโมงครึ่ง","focus":"七点半","dis":["半七点","七半点"],"tk":[{"t":"我","py":"wǒ"},{"t":"七","py":"qī"},{"t":"点","py":"diǎn"},{"t":"半","py":"bàn"},{"t":"起床","py":"qǐchuáng"},{"t":"。"}]}]},{"id":"g1-28","level":1,"group":"Expressions","title":"Ordinal numbers with 第","pattern":"第 + Number (+ Measure word)","note_en":"第 + number makes an ordinal: 第一 means \"first\".","note_th":"第 + ตัวเลข = ลำดับที่ เช่น 第一 = ที่หนึ่ง","ex":[{"zh":"今天是第一天。","en":"Today is the first day.","th":"วันนี้เป็นวันแรก","focus":"第一","dis":["一第","第个"],"tk":[{"t":"今天","py":"jīntiān"},{"t":"是","py":"shì"},{"t":"第","py":"dì"},{"t":"一","py":"yī"},{"t":"天","py":"tiān"},{"t":"。"}]},{"zh":"他是第一个到学校的。","en":"He was the first one to get to school.","th":"เขาเป็นคนแรกที่มาถึงโรงเรียน","focus":"第一个","dis":["一个第","个第一"],"tk":[{"t":"他","py":"tā"},{"t":"是","py":"shì"},{"t":"第","py":"dì"},{"t":"一","py":"yī"},{"t":"个","py":"gè"},{"t":"到","py":"dào"},{"t":"学校","py":"xuéxiào"},{"t":"的","py":"de"},{"t":"。"}]},{"zh":"这是第二本书。","en":"This is the second book.","th":"นี่คือหนังสือเล่มที่สอง","focus":"第二本","dis":["二第本","第本二"],"tk":[{"t":"这","py":"zhè"},{"t":"是","py":"shì"},{"t":"第","py":"dì"},{"t":"二","py":"èr"},{"t":"本","py":"běn"},{"t":"书","py":"shū"},{"t":"。"}]},{"zh":"我们学习第三课。","en":"We're studying Lesson 3.","th":"เรากำลังเรียนบทที่สาม","focus":"第三课","dis":["三第课","第课三"],"tk":[{"t":"我们","py":"wǒmen"},{"t":"学习","py":"xuéxí"},{"t":"第","py":"dì"},{"t":"三","py":"sān"},{"t":"课","py":"kè"},{"t":"。"}]}]},{"id":"g2-01","level":2,"group":"Comparison","title":"比 comparisons","pattern":"A + 比 + B + Adj (+ amount)"},{"id":"g2-02","level":2,"group":"Comparison","title":"没有 comparisons","pattern":"A + 没有 + B + (那么) + Adj"},{"id":"g2-03","level":2,"group":"Complements","title":"得 to describe how an action is done","pattern":"Verb + 得 + Adj"},{"id":"g2-04","level":2,"group":"Complements","title":"Result complements 完/懂/好/错/会","pattern":"Verb + 完/懂/好/错/会"},{"id":"g2-05","level":2,"group":"Complements","title":"Direction complements 来/去","pattern":"Verb + 来/去 · Verb + 出来/回去/进来…"},{"id":"g2-06","level":2,"group":"Complements","title":"Duration of an action","pattern":"Verb + (了) + Duration (+ Object)"},{"id":"g2-07","level":2,"group":"Aspect","title":"过 for past experience","pattern":"Verb + 过 (+ Object)"},{"id":"g2-08","level":2,"group":"Aspect","title":"着 for an ongoing state","pattern":"Verb + 着"},{"id":"g2-09","level":2,"group":"Aspect","title":"快要/就要/要……了 (about to)","pattern":"快要/就要 + Verb + 了"},{"id":"g2-10","level":2,"group":"Structures","title":"是……的 to stress when/where/how","pattern":"Subject + 是 + Time/Place/Way + Verb + 的"},{"id":"g2-11","level":2,"group":"Structures","title":"请/叫/让 (ask/make someone do)","pattern":"A + 请/叫/让 + B + Verb"},{"id":"g2-12","level":2,"group":"Structures","title":"给 with two objects","pattern":"Verb + 给 + Person + Thing"},{"id":"g2-13","level":2,"group":"Structures","title":"Place + Verb + 着 (something is there)","pattern":"Place + Verb + 着 + Noun"},{"id":"g2-14","level":2,"group":"Questions","title":"还是 for 'or' in questions","pattern":"A + 还是 + B？"},{"id":"g2-15","level":2,"group":"Questions","title":"为什么 (why)","pattern":"Subject + 为什么 + Verb？"},{"id":"g2-16","level":2,"group":"Negation","title":"别 for 'don't'","pattern":"别 + Verb (+ 了)"},{"id":"g2-17","level":2,"group":"Verbs","title":"Verb doubling for 'a little'","pattern":"VV · V一V · V了V"},{"id":"g2-18","level":2,"group":"Modifiers","title":"地 to describe how (adverbial)","pattern":"Adj + 地 + Verb"},{"id":"g2-19","level":2,"group":"Adverbs","title":"已经……了 (already)","pattern":"已经 + Verb + 了"},{"id":"g2-20","level":2,"group":"Adverbs","title":"再 vs 还 (again / still)","pattern":"再 + Verb (future) · 还 + Verb (still)"},{"id":"g2-21","level":2,"group":"Adverbs","title":"就 for 'then / right away'","pattern":"…… + 就 + Verb"},{"id":"g2-22","level":2,"group":"Prepositions","title":"从 / 往 / 跟 / 给","pattern":"从 + Place · 往 + Direction · 跟 + Person"},{"id":"g2-23","level":2,"group":"Connectors","title":"因为……所以……","pattern":"因为 + Reason，所以 + Result"},{"id":"g2-24","level":2,"group":"Connectors","title":"虽然……但是……","pattern":"虽然 + A，但是 + B"},{"id":"g2-25","level":2,"group":"Connectors","title":"一……就…… (as soon as)","pattern":"一 + Verb1，就 + Verb2"},{"id":"g2-26","level":2,"group":"Expressions","title":"Approximate numbers with 几 / 多","pattern":"几 + Measure · Number + 多 + Measure"},{"id":"g3-01","level":3,"group":"把 / 被","title":"把 sentences (doing something to an object)","pattern":"Subject + 把 + Object + Verb + Result"},{"id":"g3-02","level":3,"group":"把 / 被","title":"把 + Verb + 在/到 + Place","pattern":"Subject + 把 + Object + Verb + 在/到 + Place"},{"id":"g3-03","level":3,"group":"把 / 被","title":"被 passive","pattern":"Subject + 